# FastAPI Backend Environment Variables
# Authoritative server-side secrets ONLY. NEVER expose this file to source control.

ENVIRONMENT=development
APP_NAME="SMPS Tech Lab API"
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database Connection (Supabase PostgreSQL / asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Supabase Auth Verification
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Payment Gateway (Authoritative Server Verification)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional Email (Resend / AWS SES)
EMAIL_API_KEY=your_transactional_email_api_key_here
EMAIL_FROM="SMPS Tech Lab <no-reply@smpstechlab.com>"

# Optional Redis Cache / Rate Limiting
REDIS_URL=redis://localhost:6379/0
