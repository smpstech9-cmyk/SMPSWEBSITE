# Next.js Public Environment Variables
# Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT place service-role keys, database passwords, or payment secrets here.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase Auth & Public Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Payment Gateway (Client Public Key Only - e.g. Razorpay Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Cloudinary Permanent Media Storage (25 GB Free, No Card Required)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
